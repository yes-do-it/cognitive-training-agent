# Application
SPRING_PROFILES_ACTIVE=dev
APP_PORT=8091

# Agent and embedded MCP Server are opt-in
COGNITIVE_AGENT_ENABLED=false
COGNITIVE_MCP_ENABLED=false
COGNITIVE_OPENAI_ENABLED=true
SPRING_AI_OPENAI_MODEL=gpt-4.1-mini

# Set true only when Agent should consume an external MCP Server
COGNITIVE_MCP_CLIENT_ENABLED=false
COGNITIVE_MCP_SERVER_URL=http://localhost:8091/mcp

# MySQL - training domain
MYSQL_DATABASE=cognitive_training
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me
MYSQL_URL=jdbc:mysql://127.0.0.1:13306/cognitive_training?useUnicode=true&characterEncoding=utf8&autoReconnect=true&zeroDateTimeBehavior=convertToNull&serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true

# PostgreSQL / pgvector
PGVECTOR_DATABASE=ai-rag-knowledge
PGVECTOR_USERNAME=postgres
PGVECTOR_PASSWORD=change-me
PGVECTOR_URL=jdbc:postgresql://127.0.0.1:15432/ai-rag-knowledge
COGNITIVE_RAG_ENABLED=false

# AI provider; fill only when the Agent profile is enabled
SPRING_AI_OPENAI_BASE_URL=https://api.openai.com
SPRING_AI_OPENAI_API_KEY=replace-me

