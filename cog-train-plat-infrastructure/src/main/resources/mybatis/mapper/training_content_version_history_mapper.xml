<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.xfone.ai.infrastructure.dao.TrainingContentVersionHistoryDao">
    <resultMap id="TrainingContentVersionHistoryMap"
               type="cn.xfone.ai.infrastructure.dao.po.TrainingContentVersionHistoryPO">
        <id property="id" column="id"/>
        <result property="contentId" column="content_id"/>
        <result property="version" column="version"/>
        <result property="title" column="title"/>
        <result property="contentType" column="content_type"/>
        <result property="difficulty" column="difficulty"/>
        <result property="contentBody" column="content_body"/>
        <result property="status" column="status"/>
        <result property="sourceType" column="source_type"/>
        <result property="sourceFileName" column="source_file_name"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="cn.xfone.ai.infrastructure.dao.po.TrainingContentVersionHistoryPO"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO training_content_version_history
            (content_id, version, title, content_type, difficulty, content_body,
             status, source_type, source_file_name)
        VALUES
            (#{contentId}, #{version}, #{title}, #{contentType}, #{difficulty}, #{contentBody},
             #{status}, #{sourceType}, #{sourceFileName})
        ON DUPLICATE KEY UPDATE id = id
    </insert>

    <select id="findByContentId" resultMap="TrainingContentVersionHistoryMap">
        SELECT id, content_id, version, title, content_type, difficulty, content_body,
               status, source_type, source_file_name, created_at
        FROM training_content_version_history
        WHERE content_id = #{contentId}
        ORDER BY version ASC, id ASC
    </select>
</mapper>
