# Copy this file to .env on the server and fill in secrets before starting.
APP_PORT=8091
DB_HOST=your-server-ip
DB_PORT=13306
DB_NAME=cognitive_training
DB_USERNAME=root
DB_PASSWORD=replace-with-existing-mysql-root-password

COGNITIVE_AGENT_ENABLED=true
COGNITIVE_RAG_ENABLED=false
PGVECTOR_URL=jdbc:postgresql://your-server-ip:15432/ai-rag-knowledge
PGVECTOR_USERNAME=postgres
PGVECTOR_PASSWORD=replace-with-existing-pgvector-password
COGNITIVE_MCP_ENABLED=false
COGNITIVE_MCP_CLIENT_ENABLED=true
COGNITIVE_MCP_SERVER_URL=http://mcp:8091/mcp
COGNITIVE_OPENAI_ENABLED=true
SPRING_AI_OPENAI_MODEL=gpt-4.1-mini
SPRING_AI_OPENAI_BASE_URL=https://api.openai.com
SPRING_AI_OPENAI_API_KEY=disabled

